---
interface Props {
  title: string;
  lang: "zh" | "en";
}
const { title, lang } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang === "zh" ? "zh-Hant" : "en"} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <style is:global>
      :root {
        --color-text: #1a1a1a;
        --color-secondary: #8a8a8a;
        --color-faint: #b3b3b3;
        --color-border: #ececec;
        --color-bg: #ffffff;
        --color-pill-ink: #404040;
        --color-pill-ink-plain: #6e6e6e;
        --color-pill-ink-hover: #0a0a0a;
        --diorama-shadow: rgba(0, 0, 0, 0.08);
        --pill-blur: blur(12px) saturate(1.6) contrast(0.45) brightness(1.6);
        --pill-fill: rgba(236, 236, 236, 0.72);
        --pill-fill-pressed: rgba(216, 216, 216, 0.9);
        --font-sans: -apple-system, BlinkMacSystemFont, "PingFang TC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --day-opacity: 1;
        --night-opacity: 0;

        --bg: var(--color-bg);
        --text-primary: var(--color-text);
        --text-secondary: var(--color-secondary);
        --text-muted: var(--color-faint);
        --border-subtle: var(--color-border);
      }

      html[data-theme="dark"] {
        --color-text: #f2f2f2;
        --color-secondary: #9a9a9a;
        --color-faint: #6b6b6b;
        --color-border: #2a2a2a;
        --color-bg: #111111;
        --color-pill-ink: #bdbdbd;
        --color-pill-ink-plain: #bdbdbd;
        --color-pill-ink-hover: #f2f2f2;
        --diorama-shadow: rgba(0, 0, 0, 0.55);
        --pill-blur: blur(12px) saturate(1.4);
        --pill-fill: rgba(38, 38, 38, 0.72);
        --pill-fill-pressed: rgba(56, 56, 56, 0.9);
        --day-opacity: 0;
        --night-opacity: 1;

        --bg: var(--color-bg);
        --text-primary: var(--color-text);
        --text-secondary: var(--color-secondary);
        --text-muted: var(--color-faint);
        --border-subtle: var(--color-border);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 15px;
        font-weight: 500;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-wrap: pretty;
        transition: background-color 0.35s ease, color 0.35s ease;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4.5rem 1.5rem calc(6.5rem + env(safe-area-inset-bottom, 0px));
        overflow-x: hidden;
        -webkit-tap-highlight-color: transparent;
      }

      @media (max-width: 768px) {
        body {
          padding: max(2rem, calc(1.5rem + env(safe-area-inset-top, 0px))) max(1rem, env(safe-area-inset-right, 0px)) max(7.5rem, calc(6.5rem + env(safe-area-inset-bottom, 0px))) max(1rem, env(safe-area-inset-left, 0px));
        }
      }

      .container {
        width: 100%;
        max-width: 36rem; /* 576px, 可容納 540px 大圖並留有適當呼吸邊距 */
        margin: 0 auto;
        display: flex;
        flex-direction: column;
      }

      .container.gallery-mode {
        max-width: 960px;
      }

      .timeline-toggle-btn:hover {
        color: var(--text-primary);
      }

      .timeline-toggle-btn .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #2fb344;
        box-shadow: 0 0 8px rgba(47, 179, 68, 0.6);
      }

      .work-section {
        margin-top: 4.5rem;
        margin-bottom: 3rem;
        width: 100%;
      }

      .section-heading {
        color: var(--color-faint);
        text-align: center;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
        font-weight: 500;
      }

      .work-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
      }

      .work-item {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: baseline;
        gap: 0 0.5rem;
        width: fit-content;
        max-width: 100%;
        margin-inline: auto;
        font-size: 1.25rem;
        line-height: 1.6;
        padding-block: 0.375rem;
      }

      @media (max-width: 640px) {
        .work-section {
          margin-top: 2rem;
          margin-bottom: 2rem;
        }

        .section-heading {
          font-size: 1.0625rem;
          text-align: left;
          margin-bottom: 0.75rem;
          padding-left: 0.25rem;
        }

        .work-list {
          background: rgba(138, 138, 138, 0.05);
          border: 1px solid var(--color-border);
          border-radius: 16px;
          padding: 0.35rem 0.85rem;
        }

        .work-item {
          font-size: 0.9375rem;
          width: 100%;
          margin: 0;
          padding: 0.65rem 0.15rem;
          display: flex;
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-start;
          border-bottom: 1px solid var(--color-border);
          gap: 0.75rem;
        }

        .work-item:last-child {
          border-bottom: none;
        }

        .guide-label {
          font-size: 0.875rem;
          color: var(--color-secondary);
          min-width: 4.5rem;
          flex-shrink: 0;
          margin-right: 0;
        }

        .guide-value {
          font-size: 0.9375rem;
          color: var(--color-text);
          text-align: right;
          line-height: 1.45;
          flex: 1;
          word-break: break-word;
      }

      .work-item a {
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.15s;
      }

      .work-item a:hover {
        color: var(--color-secondary);
      }

      .work-leader {
        display: none;
      }

      .work-year {
        color: var(--color-faint);
        font-variant-numeric: tabular-nums;
        font-size: 1.125rem;
      }

      .guide-label {
        font-weight: 500;
        color: var(--color-text);
        margin-right: 0.6rem;
      }

      .guide-value {
        color: var(--color-secondary);
        font-size: 1.125rem;
        font-weight: 400;
      }

      .guide-value a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s;
      }

      .guide-value a:hover {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .site-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 16px;
        border-top: 1px solid var(--border-subtle);
        font-size: 13.5px;
        color: var(--text-secondary);
      }

      .social-links {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .social-links a,
      .control-btn {
        color: var(--text-secondary);
        text-decoration: none;
        background: none;
        border: none;
        font-family: inherit;
        font-size: 13.5px;
        cursor: pointer;
      }

      .social-links a:hover,
      .control-btn:hover {
        color: var(--text-primary);
      }

      .footer-controls {
        display: flex;
        align-items: center;
        gap: 14px;
      }
    </style>
  </head>
  <body>
    <main class="container gallery-mode">
      <slot />
    </main>
  </body>
</html>
